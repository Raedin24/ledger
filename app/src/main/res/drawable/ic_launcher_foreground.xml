<?xml version="1.0" encoding="utf-8"?>
<!--
  The Ledger mark: a struck coin seal with the Ghanaian cedi at its centre.
  Paper (#F1E9D8) on the terracotta field supplied by the adaptive background.

  Authored in the design's own 100-unit glyph space and mapped into the 108dp
  adaptive canvas by the wrapping group, so every number below reads straight
  against the spec. The scale puts the solid ring at 40% of the 72dp a launcher
  actually shows — the ratio the design's own launcher-size strip uses — which
  leaves the seal the breathing room the mark is built around.

  The cedi is drawn as paths, not text: VectorDrawable has no text element, and a
  font-dependent glyph would render differently on every device. The bowl is a
  true annulus sector whose inner counter is proportionally narrower than its
  outer bowl, which is what produces the serif modulation — thick sides (6.4
  units), thin top and bottom (4.9) — tying it to the Newsreader wordmark.

  The stroke through the bowl is a parallelogram leaning 14° off vertical, not the
  upright bar this first shipped with: the design's ₵ is slanted, and upright read
  as a different glyph. It is 5.6 units wide, so it sits between the bowl's thick
  and thin axes rather than looking like a hairline against them. Its geometry is
  mirrored in ui/components/SealMark.kt so the splash draws the same mark rather
  than a font's idea of one.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.4364"
        android:scaleY="0.4364"
        android:translateX="4"
        android:translateY="4">

        <!-- Outer ring — the struck edge of the coin. -->
        <path
            android:strokeColor="#F1E9D8"
            android:strokeWidth="3.4"
            android:pathData="M50,15.6 A33,33 0 1 1 50,81.6 A33,33 0 1 1 50,15.6 Z" />

        <!-- Inner "struck" ring. VectorDrawable has no dash array, so the
             design's `stroke-dasharray: 2 5.5` is drawn as the 23 discrete arc
             segments that pattern resolves to at this radius. -->
        <path
            android:strokeColor="#F1E9D8"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:pathData="M50,21.6 A27,27 0 0 1 52,21.67 M57.28,22.6 A27,27 0 0 1 59.19,23.21 M64.03,25.53 A27,27 0 0 1 65.7,26.63 M69.73,30.17 A27,27 0 0 1 71.04,31.68 M73.97,36.18 A27,27 0 0 1 74.83,37.99 M76.44,43.11 A27,27 0 0 1 76.77,45.08 M76.94,50.44 A27,27 0 0 1 76.73,52.43 M75.44,57.64 A27,27 0 0 1 74.7,59.5 M72.06,64.17 A27,27 0 0 1 70.85,65.76 M67.04,69.54 A27,27 0 0 1 65.44,70.75 M60.76,73.36 A27,27 0 0 1 58.89,74.09 M53.68,75.35 A27,27 0 0 1 51.69,75.55 M46.32,75.35 A27,27 0 0 1 44.35,75 M39.24,73.36 A27,27 0 0 1 37.44,72.5 M32.96,69.54 A27,27 0 0 1 31.46,68.23 M27.94,64.17 A27,27 0 0 1 26.85,62.5 M24.56,57.64 A27,27 0 0 1 23.96,55.73 M23.06,50.44 A27,27 0 0 1 23,48.44 M23.56,43.11 A27,27 0 0 1 24.04,41.17 M26.03,36.18 A27,27 0 0 1 27.01,34.44 M30.27,30.17 A27,27 0 0 1 31.69,28.76 M35.97,25.53 A27,27 0 0 1 37.72,24.56 M42.72,22.6 A27,27 0 0 1 44.66,22.13" />

        <!-- ₵ — the bowl, open to the right with cut, flared terminals. -->
        <path
            android:fillColor="#F1E9D8"
            android:pathData="M58.948,34.674 A16,16.8 0 1 0 58.948,62.526 L58.35,54.471 A9.6,11.9 0 1 1 58.35,42.729 Z" />
        <!-- ₵ — the slanted stroke, overhanging the bowl top and bottom. Kept as
             its own path (each fills independently here) but wound to match the
             bowl's outer arc, because SealMark.kt combines the two into one
             non-zero-filled path where opposite windings would punch a hole
             exactly where the stroke crosses the bowl. -->
        <path
            android:fillColor="#F1E9D8"
            android:pathData="M51.99,29.4 L42.41,67.8 L48.01,67.8 L57.59,29.4 Z" />
    </group>
</vector>
