<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon: the design's simplified seal as a white-on-transparent
  silhouette, 24dp.

  Android uses a notification's small icon as a mask and colours it itself, so
  it has to be a flat shape on a transparent background. The full-colour
  launcher icon would show as a solid blob.

  Like the themed icon, it is one solid ring and the ₵, without the dashed ring.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.294"
        android:scaleY="0.294"
        android:translateX="-38"
        android:translateY="-38">

        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.4"
            android:pathData="M50,14.6 A34,34 0 1 1 50,82.6 A34,34 0 1 1 50,14.6 Z" />

        <group
            android:pivotX="50"
            android:pivotY="48.6"
            android:scaleX="1.087"
            android:scaleY="1.087">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M58.948,34.674 A16,16.8 0 1 0 58.948,62.526 L58.35,54.471 A9.6,11.9 0 1 1 58.35,42.729 Z" />
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M51.99,29.4 L42.41,67.8 L48.01,67.8 L57.59,29.4 Z" />
        </group>
    </group>
</vector>
