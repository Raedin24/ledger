<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and transfer rules for Android 12+. Everything is excluded: the
  encrypted database and any exports must never leave the device through cloud
  backup or device-to-device transfer. Together with allowBackup="false", this
  stops Android's automatic backup from copying the app's private storage.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
