<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose does the real theming. This is the base theme the app runs in
         after the splash. The cream background matches the app, so there is no
         white flash. -->
    <style name="Theme.Ledger" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      The launch theme. It shows only the cream page (splash_no_icon explains
      why there is no mark). Once installSplashScreen() runs, the activity
      switches to postSplashScreenTheme, so Theme.Ledger applies to the running
      app.
    -->
    <style name="Theme.Ledger.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_no_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Ledger</item>
    </style>
</resources>
