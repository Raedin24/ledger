<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions are kept to the minimum. RECEIVE_SMS lets the app see new
      alerts. It never sends SMS and is not the default SMS app.

      There is no INTERNET permission, so the app can't make network calls even
      if a library tried to. Check the merged manifest before every release to
      make sure that is still true.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!--
      READ_SMS is for the one-time "Import past transactions" action. It reads
      messages from supported providers already in the inbox, parses them on the
      device, and never stores the message text. Google Play restricts READ_SMS,
      so the app is installed directly from GitHub instead.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Remove any INTERNET permission a library might add. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!--
      The SMS permissions imply telephony hardware, which would hide the app from
      tablets and Chrome OS. The app still works without SMS (cash entries, backup
      import), so telephony is marked optional.
    -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".LedgerApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ledger">

        <!-- Starts with the splash theme. installSplashScreen() switches it to
             Theme.Ledger through postSplashScreenTheme. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Ledger.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          SMS_RECEIVED is a protected broadcast that only Android can send, and the
          BROADCAST_SMS permission below means no other app can call this receiver.
          The high priority makes the app see new alerts promptly.
        -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
