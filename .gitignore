# Android / Gradle / IntelliJ
*.iml
.gradle/
.kotlin/
.idea/
.DS_Store
/build
*/build/
/captures
.externalNativeBuild
.cxx
local.properties

# Signing material. The keystore and its passwords never go in the repo. A lost
# key can't be replaced (Android won't update an app whose signature changed),
# and a leaked one would let anyone sign a build that passes as this one.
/keystore.properties
*.jks
*.keystore

# Keep out anything that could leak real financial data
*.ledger
*.csv
*.db
*.db-*

# Local files that aren't part of the project: notes, reports, logs and
# design files.
/local/
*.logcat
.claude/
