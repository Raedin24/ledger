local.properties

# Signing material. The keystore and its passwords never enter the repo — losing
# the key is unrecoverable (Android refuses to update an app whose signature
# changed), and leaking it lets anyone ship a build that impersonates this one.
/keystore.properties
*.jks
*.keystore

# Keep out anything that could leak real financial data
*.ledger
*.csv
*.db
*.db-*

# Working notes and planning trackers. Kept locally; the READMEs carry the
# published account of what the project is and what is still open.
/expense-tracker-app-decisions.md
/PROJECT_ROADMAP.md
/REMAINING_WORK.md

# Local tooling artefacts, not part of the app
/index.html
/script.js
/styles.css
/*.logcat
/ledger_mobsf_report.pdf
.claude/

# Design mock the palette and type scale were taken from. Kept locally; the
